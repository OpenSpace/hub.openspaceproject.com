{
  "name": "openspace-hub-be",
  "version": "0.1.0",
  "description": "CMS for OpenSpace Hub",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:payload-secret": "node ./src/scripts/generate-payload-secret.mjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "seed": "payload run ./src/scripts/run-seed.ts",
    "backfill:favorites-count": "payload run ./src/scripts/run-backfill-favorites-count.ts",
    "backfill:openspace-version-tags": "payload run ./src/scripts/run-backfill-openspace-version-tags.ts",
    "backfill:title-lower": "payload run ./src/scripts/run-backfill-title-lower.ts",
    "backfill:asset-entry-path": "payload run ./src/scripts/run-backfill-asset-entry-path.ts",
    "backfill:asset-contents": "payload run ./src/scripts/run-backfill-asset-contents.ts",
    "migrate:user-folders": "payload run ./src/scripts/run-move-uploads-to-user-folders.ts",
    "backup": "payload run ./src/scripts/run-backup.ts",
    "cleanup:orphans": "payload run ./src/scripts/run-cleanup-orphans.ts",
    "make-admin": "payload run ./src/scripts/run-make-admin.ts",
    "unlock-admin": "payload run ./src/scripts/unlock-admin.ts",
    "add:showcomposer-type": "payload run ./src/scripts/run-add-showcomposer-type.ts",
    "backfill:item-type-tags": "payload run ./src/scripts/run-backfill-item-type-tags.ts"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/payload-cloud": "3.93.0",
    "@payloadcms/plugin-cloud-storage": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "fflate": "^0.8.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "graphql": "^16.8.1",
    "next": "16.4.5",
    "payload": "3.93.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/unzipper": "^0.10.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
