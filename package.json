{
    "name": "openspace-hub",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "hub-be",
        "hub-fe"
    ],
    "scripts": {
        "dev": "concurrently \"npm:dev:fe\" \"npm:dev:be\"",
        "dev:fe": "npm run dev -w hub-fe",
        "dev:be": "npm run dev -w hub-be",
        "build": "npm run build:fe && node scripts/copy-frontend.mjs && npm run build:be",
        "build:fe": "npm run build -w hub-fe",
        "build:be": "npm run build -w hub-be",
        "build:local": "node scripts/build-frontend.mjs http://localhost:3000",
        "build:remote": "node scripts/build-frontend.mjs http://hub.openspaceproject.com:3000",
        "start": "npm start -w hub-be"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
