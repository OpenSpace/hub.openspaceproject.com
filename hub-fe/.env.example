# Firebase web app settings (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Where the backend runs. Production builds use .env.production instead
VITE_PAYLOAD_API_URL=http://localhost:3000

# Slack workspace and channel the hub links to
VITE_SLACK_TEAM_ID=
VITE_SLACK_CHANNEL_ID=
